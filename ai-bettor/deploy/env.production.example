# AI Bettor — production environment.
#
# Copy to the project root as `.env` and fill in. Never commit the filled copy;
# `.env` is already git-ignored.
#
#   cp deploy/env.production.example .env
#
# Keys marked REQUIRED must be set before the app is reachable from the internet.

# ---------------------------------------------------------------
# Access control (REQUIRED on a public VPS)
# ---------------------------------------------------------------
# Shared token for every API call. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty value = the API is completely open. The app logs a warning if so.
API_TOKEN=

# Comma-separated origins allowed to call the API from a browser.
# Use the exact dashboard URL. Empty or "*" = any origin (development only).
ALLOWED_ORIGINS=https://bettor.example.com

# ---------------------------------------------------------------
# Database — Neon (REQUIRED)
# ---------------------------------------------------------------
# From the Neon console: Connection string > Pooled connection.
# The pooled host (…-pooler…) is the right one for a web app: it multiplexes
# short-lived connections. `sslmode=require` is appended automatically if you
# leave it out. `postgres://` and `postgresql://` are both accepted.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/ai_bettor?sslmode=require

# Leave false in production. When true, an unreachable Postgres silently
# downgrades to a local SQLite file — useful offline, dangerous on a server
# because the app comes up with an empty database.
ALLOW_SQLITE_FALLBACK=false

# Pool sizing. Neon's pooler is happy with a small pool; recycle stays inside
# its idle timeout so a dead connection is never handed to a request.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=280
DB_CONNECT_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------
# The Odds API. Multiple keys rotate automatically (round-robin + cooldown).
THE_ODDS_API_KEYS=
THE_ODDS_API_KEY=

# OpenRouter — used only for the qualitative LLM review, which can downgrade a
# pick but never create one. Leave empty to disable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
LLM_REVIEW_ENABLED=true

# Telegram notifications for picks above TELEGRAM_MIN_SCORE.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=85
TELEGRAM_MAX_PICKS=5
TELEGRAM_SEND_NO_BET=true

# ---------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------
TIMEZONE=Asia/Jakarta
# PAPER never places real money. Keep it that way until the log is convincing.
BETTING_MODE=PAPER
INITIAL_BANKROLL=1000

# Scheduler
SCAN_AUTOMATION_ENABLED=true
AGENT_SCAN_INTERVAL_SECONDS=900
EARLY_MORNING_ONLY=true
EARLY_MORNING_END_HOUR=6
EARLY_MORNING_DAYS=2

# Modelling
MONTE_CARLO_SIMULATIONS=20000
SIMULATION_BATCHES=3
RANDOM_SEED=42

# Uvicorn bind (systemd deploy only; Docker sets these itself)
HOST=127.0.0.1
PORT=8000
RELOAD=false
