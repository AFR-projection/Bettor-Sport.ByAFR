# API Keys
# Single key (opsional — otomatis didaftarkan di router)
THE_ODDS_API_KEY=
# Multi-key (opsional) — JSON list, failover otomatis A -> B -> C
# THE_ODDS_API_KEYS=["key_a","key_b","key_c"]
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=postgresql://localhost:5432/ai_bettor

# Timezone
TIMEZONE=Asia/Jakarta

# Monte Carlo Configuration
MONTE_CARLO_SIMULATIONS=20000
RANDOM_SEED=42

# Polling
ODDS_POLL_INTERVAL_SECONDS=300

# Betting thresholds
MIN_EDGE=0.01
MIN_EV=0.01
MIN_CONFIDENCE=60

# Betting mode
BETTING_MODE=PAPER

# Agent configuration
AGENT_SCAN_INTERVAL_SECONDS=60